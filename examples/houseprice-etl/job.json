{
  "Name": "houseprice-etl-{proj.id}",
  "Description": "Job da aplicação houseprice-etl, criado e atualizado pelo workflow",
  "Role": "{proj.iam_role_arn}",
  "ExecutionProperty": {
    "MaxConcurrentRuns": 1
  },
  "Command": {
    "Name": "glueetl",
    "ScriptLocation": "{proj.connection.default.s3_shared.s3Uri}exemplos/houseprice-etl/glue/etl_houseprice.py",
    "PythonVersion": "3"
  },
  "MaxRetries": 0,
  "GlueVersion": "6.0",
  "WorkerType": "G.1X",
  "NumberOfWorkers": 2,
  "Timeout": 50,
  "Connections": {
    "Connections": [
      "datazone-glue-network-connection-{env.SUBNET_AZ1}-{proj.id}-dev",
      "datazone-glue-network-connection-{env.SUBNET_AZ2}-{proj.id}-dev"
    ]
  },
  "DefaultArguments": {
    "--custom-logGroup-prefix": "datazone-{proj.id}-dev"
  },
  "Tags": {
    "AmazonDataZoneProject": "{proj.id}"
  }
}
